{
	"name": "homebridge-abode-lights",
	"displayName": "Homebridge Abode Lights",
	"version": "2.0.7",
	"description": "Homebridge plugin for integrating Abode Switches and Dimmers into HomeKit.",
	"author": "Chris Smith",
	"license": "MIT",
	"main": "dist/index.js",
	"scripts": {
		"lint": "eslint src/**.ts src/devices/**/**.ts src/utils/**.ts --max-warnings=0",
		"eslint:github-action": "eslint src/",
		"build": "rm -rf dist && tsc",
		"watch": "npm run build && npm link && nodemon",
		"test": "jest",
		"test:bulb": "jest src/devices/bulb/bulb.test.ts"
	},
	"engines": {
		"homebridge": ">=1.8.0 || >=2.0.0",
		"node": ">=20"
	},
	"keywords": [
		"homebridge-plugin"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisbsmith/homebridge-abode-lights.git"
	},
	"bugs": {
		"url": "https://github.com/chrisbsmith/homebridge-abode-lights/issues"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.9.2",
		"@types/uuid": "11.0.0",
		"@types/ws": "8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"axios-mock-adapter": "^2.1.0",
		"eslint": "8.57.0",
		"homebridge": "^1.11.4",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.11",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"axios": "1.16.0",
		"color-convert": "3.1.3",
		"kelvin-to-rgb": "1.0.2",
		"lodash": "4.18.1",
		"uuid": "14.0.0",
		"ws": "^8.21.0"
	}
}
